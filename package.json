{
  "name": "techscrum-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "yarn install && yarn build:backend && yarn workspace be.techscrum setup",
    "predev": "lsof -ti:3000 -ti:8000 | xargs kill -9 2>/dev/null || true",
    "dev": "concurrently -n backend,frontend -c blue,green \"yarn workspace be.techscrum dev\" \"yarn workspace fe.techscrum start\"",
    "dev:backend": "yarn workspace be.techscrum dev",
    "dev:frontend": "yarn workspace fe.techscrum start",
    "build": "yarn build:backend && yarn build:frontend",
    "build:backend": "yarn workspace be.techscrum build",
    "build:frontend": "yarn workspace fe.techscrum build",
    "start": "yarn start:backend",
    "start:backend": "yarn workspace be.techscrum start",
    "deploy": "yarn workspace fe.techscrum deploy",
    "cdn": "yarn workspace fe.techscrum cdn",
    "lint": "yarn workspace be.techscrum lint && yarn workspace fe.techscrum lint",
    "test": "yarn workspace be.techscrum test",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^7.1.0",
    "husky": "^8.0.1"
  },
  "resolutions": {
    "eslint-plugin-jsx-a11y": "6.7.1",
    "fe.techscrum/date-fns": "4.1.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.2.7"
  }
}
